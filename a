def array_rank_transform(nums):

    numS= sorted(nums)
    rank ={}
    for i, num in enumerate(numS):

        if num not in rank:
            rank[num] = i
    result = []
    for num in nums:
        result.append(rank[num])
    
    return result 

nums = [40, 10, 20, 30]
result = array_rank_transform(nums)
print(result)  # Expected output: [3, 0, 1, 2]